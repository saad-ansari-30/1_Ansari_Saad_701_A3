<!DOCTYPE html>
<html>

<head>

    <title>Employees</title>

    <style>

        body {
            font-family: Arial, sans-serif;
            margin: 30px;
            background-color: #f5f5f5;
        }

        h1 {
            color: #333;
        }

        a {
            text-decoration: none;
        }

        .btn {
            display: inline-block;
            padding: 8px 14px;
            margin: 3px;
            border-radius: 5px;
            color: white;
            border: none;
            cursor: pointer;
        }

        .btn-add {
            background-color: green;
        }

        .btn-edit {
            background-color: #2563eb;
        }

        .btn-delete {
            background-color: #dc2626;
        }

        .btn-dashboard {
            background-color: #555;
        }

        /* =====================================
           SUCCESS MESSAGE
           ===================================== */

        .success-box {
            background-color: #d1fae5;
            border: 2px solid #10b981;
            padding: 20px;
            margin-top: 20px;
            border-radius: 10px;
        }

        .success-box h3 {
            color: #047857;
            margin-top: 0;
        }

        .success-box p {
            margin: 8px 0;
            font-size: 16px;
        }

        .password-box {
            display: inline-block;
            background-color: white;
            border: 1px solid #10b981;
            padding: 6px 12px;
            border-radius: 5px;
            font-weight: bold;
            color: #111827;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background-color: white;
            margin-top: 20px;
        }

        th,
        td {
            border: 1px solid #ccc;
            padding: 10px;
            text-align: center;
        }

        th {
            background-color: #333;
            color: white;
        }

        tr:nth-child(even) {
            background-color: #f2f2f2;
        }

        form {
            display: inline;
        }

    </style>

</head>


<body>

    <h1>Employee List</h1>


    <!-- =====================================
         ADD EMPLOYEE
         ===================================== -->

    <a href="/employees/add"
       class="btn btn-add">

        Add New Employee

    </a>


    <!-- =====================================
         DASHBOARD
         ===================================== -->

    <a href="/dashboard"
       class="btn btn-dashboard">

        Back to Dashboard

    </a>


    <hr>


    <!-- =====================================
         NEW EMPLOYEE SUCCESS MESSAGE
         ===================================== -->

    <% if (success && newEmployee) { %>

        <div class="success-box">

            <h3>
                Employee Added Successfully!
            </h3>

            <p>
                <strong>Name:</strong>
                <%= newEmployee.name %>
            </p>

            <p>
                <strong>Employee ID:</strong>
                <%= newEmployee.empId %>
            </p>

            <p>
                <strong>Password:</strong>

                <span class="password-box">
                    <%= newEmployee.password %>
                </span>
            </p>

            <p>
                <strong>Important:</strong>
                Use this Employee ID and Password
                for Q5 Employee Login.
            </p>

        </div>

    <% } %>


    <!-- =====================================
         EMPLOYEE LIST
         ===================================== -->

    <% if (employees.length === 0) { %>

        <h3>No employees found.</h3>

    <% } else { %>


        <table>

            <tr>

                <th>Emp ID</th>

                <th>Name</th>

                <th>Email</th>

                <th>Department</th>

                <th>Designation</th>

                <th>Basic Salary</th>

                <th>HRA</th>

                <th>DA</th>

                <th>Gross Salary</th>

                <th>Joining Date</th>

                <th>Actions</th>

            </tr>


            <% employees.forEach(employee => { %>

                <tr>

                    <td>
                        <%= employee.empId %>
                    </td>

                    <td>
                        <%= employee.name %>
                    </td>

                    <td>
                        <%= employee.email %>
                    </td>

                    <td>
                        <%= employee.department %>
                    </td>

                    <td>
                        <%= employee.designation %>
                    </td>

                    <td>
                        ₹<%= employee.basicSalary %>
                    </td>

                    <td>
                        ₹<%= employee.hra %>
                    </td>

                    <td>
                        ₹<%= employee.da %>
                    </td>

                    <td>
                        ₹<%= employee.grossSalary %>
                    </td>

                    <td>
                        <%= employee.joiningDate.toISOString().split("T")[0] %>
                    </td>


                    <td>

                        <!-- EDIT -->

                        <a
                            href="/employees/edit/<%= employee._id %>"
                            class="btn btn-edit">

                            Edit

                        </a>


                        <!-- DELETE -->

                        <form
                            action="/employees/delete/<%= employee._id %>"
                            method="POST"
                            onsubmit="return confirm('Are you sure you want to delete this employee?');">

                            <button
                                type="submit"
                                class="btn btn-delete">

                                Delete

                            </button>

                        </form>

                    </td>

                </tr>

            <% }); %>

        </table>

    <% } %>


    <br>


    <!-- LOGOUT -->

    <a href="/logout"
       class="btn btn-delete">

        Logout

    </a>


</body>

</html>