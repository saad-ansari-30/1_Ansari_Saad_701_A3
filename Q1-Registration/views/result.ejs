<!DOCTYPE html>
<html>

<head>

    <title>Registration Result</title>

    <style>

        body {
            font-family: Arial, sans-serif;
            background: #f3f4f6;
            padding: 30px;
        }

        .container {
            width: 900px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.15);
        }

        h1 {
            text-align: center;
            color: #16a34a;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th,
        td {
            border: 1px solid #ddd;
            padding: 12px;
            text-align: left;
        }

        th {
            background: #2563eb;
            color: white;
        }

        img {
            width: 120px;
            height: 120px;
            object-fit: cover;
            border-radius: 8px;
        }

        .other-images img {
            margin: 10px;
        }

        .download {
            display: inline-block;
            margin-top: 20px;
            padding: 10px 15px;
            background: #16a34a;
            color: white;
            text-decoration: none;
            border-radius: 5px;
        }

        .back {
            display: inline-block;
            margin-top: 20px;
            padding: 10px 15px;
            background: #6b7280;
            color: white;
            text-decoration: none;
            border-radius: 5px;
        }

    </style>

</head>


<body>

<div class="container">

    <h1>Registration Successful</h1>


    <table>

        <tr>
            <th>Field</th>
            <th>Information</th>
        </tr>


        <tr>

            <td>Username</td>

            <td>
                <%= data.username %>
            </td>

        </tr>


        <tr>

            <td>Email</td>

            <td>
                <%= data.email %>
            </td>

        </tr>


        <tr>

            <td>Gender</td>

            <td>
                <%= data.gender %>
            </td>

        </tr>


        <tr>

            <td>Hobbies</td>

            <td>
                <%= data.hobbies.join(", ") %>
            </td>

        </tr>


        <tr>

            <td>Profile Picture</td>

            <td>

                <% if (data.profilePic) { %>

                    <img
                        src="<%= data.profilePic %>"
                        alt="Profile Picture"
                    >

                    <br>

                    <a
                        class="download"
                        href="/download/<%= data.profilePic.split('/').pop() %>"
                    >
                        Download Profile Picture
                    </a>

                <% } %>

            </td>

        </tr>


        <tr>

            <td>Other Pictures</td>

            <td>

                <div class="other-images">

                    <% data.otherPics.forEach(function(pic) { %>

                        <img
                            src="<%= pic %>"
                            alt="Other Picture"
                        >

                        <br>

                        <a
                            class="download"
                            href="/download/<%= pic.split('/').pop() %>"
                        >
                            Download Image
                        </a>

                        <br><br>

                    <% }) %>

                </div>

            </td>

        </tr>


    </table>


    <br>


    <a
        href="/"
        class="back"
    >
        Back to Registration
    </a>


</div>

</body>

</html>