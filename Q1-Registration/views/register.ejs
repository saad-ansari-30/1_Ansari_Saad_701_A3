<!DOCTYPE html>
<html>

<head>

    <title>User Registration</title>

    <style>

        body {
            font-family: Arial, sans-serif;
            background: #f3f4f6;
            margin: 0;
            padding: 30px;
        }

        .container {
            width: 600px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.15);
        }

        h1 {
            text-align: center;
            color: #2563eb;
        }

        label {
            display: block;
            margin-top: 15px;
            font-weight: bold;
        }

        input[type="text"],
        input[type="password"],
        input[type="email"],
        input[type="file"] {
            width: 100%;
            padding: 10px;
            margin-top: 5px;
            box-sizing: border-box;
        }

        .radio-group,
        .checkbox-group {
            margin-top: 8px;
        }

        .radio-group label,
        .checkbox-group label {
            display: inline;
            margin-right: 15px;
            font-weight: normal;
        }

        .error {
            background: #fee2e2;
            color: #b91c1c;
            padding: 10px;
            margin-bottom: 15px;
            border-radius: 5px;
        }

        button {
            width: 100%;
            margin-top: 25px;
            padding: 12px;
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 16px;
        }

        button:hover {
            background: #1d4ed8;
        }

    </style>

</head>


<body>

<div class="container">

    <h1>User Registration</h1>


    <!-- Display Errors -->

    <% if (errors && errors.length > 0) { %>

        <% errors.forEach(error => { %>

            <div class="error">
                <%= error.msg %>
            </div>

        <% }) %>

    <% } %>


    <form
        action="/register"
        method="POST"
        enctype="multipart/form-data"
    >


        <!-- Username -->

        <label>Username</label>

        <input
            type="text"
            name="username"
            value="<%= oldData.username || '' %>"
        >


        <!-- Password -->

        <label>Password</label>

        <input
            type="password"
            name="password"
        >


        <!-- Confirm Password -->

        <label>Confirm Password</label>

        <input
            type="password"
            name="confirmPassword"
        >


        <!-- Email -->

        <label>Email</label>

        <input
            type="email"
            name="email"
            value="<%= oldData.email || '' %>"
        >


        <!-- Gender -->

        <label>Gender</label>

        <div class="radio-group">

            <label>
                <input
                    type="radio"
                    name="gender"
                    value="Male"
                    <%= oldData.gender === "Male" ? "checked" : "" %>
                >
                Male
            </label>

            <label>
                <input
                    type="radio"
                    name="gender"
                    value="Female"
                    <%= oldData.gender === "Female" ? "checked" : "" %>
                >
                Female
            </label>

            <label>
                <input
                    type="radio"
                    name="gender"
                    value="Other"
                    <%= oldData.gender === "Other" ? "checked" : "" %>
                >
                Other
            </label>

        </div>


        <!-- Hobbies -->

        <label>Hobbies</label>

        <div class="checkbox-group">

            <label>
                <input
                    type="checkbox"
                    name="hobbies"
                    value="Reading"
                    <%= oldData.hobbies && (Array.isArray(oldData.hobbies)
                        ? oldData.hobbies.includes("Reading")
                        : oldData.hobbies === "Reading")
                        ? "checked"
                        : "" %>
                >
                Reading
            </label>


            <label>
                <input
                    type="checkbox"
                    name="hobbies"
                    value="Music"
                    <%= oldData.hobbies && (Array.isArray(oldData.hobbies)
                        ? oldData.hobbies.includes("Music")
                        : oldData.hobbies === "Music")
                        ? "checked"
                        : "" %>
                >
                Music
            </label>


            <label>
                <input
                    type="checkbox"
                    name="hobbies"
                    value="Sports"
                    <%= oldData.hobbies && (Array.isArray(oldData.hobbies)
                        ? oldData.hobbies.includes("Sports")
                        : oldData.hobbies === "Sports")
                        ? "checked"
                        : "" %>
                >
                Sports
            </label>


            <label>
                <input
                    type="checkbox"
                    name="hobbies"
                    value="Travel"
                    <%= oldData.hobbies && (Array.isArray(oldData.hobbies)
                        ? oldData.hobbies.includes("Travel")
                        : oldData.hobbies === "Travel")
                        ? "checked"
                        : "" %>
                >
                Travel
            </label>

        </div>


        <!-- Profile Picture -->

        <label>Profile Picture</label>

        <input
            type="file"
            name="profilePic"
            accept="image/*"
        >


        <!-- Other Pictures -->

        <label>Other Pictures</label>

        <input
            type="file"
            name="otherPics"
            accept="image/*"
            multiple
        >


        <!-- Submit -->

        <button type="submit">
            Register
        </button>


    </form>

</div>

</body>

</html>